seed: 0
use_wandb: true
wandb:
  project: dmri
  entity: null
simulator:
  sim_type:
    name: BallStickZeppelinNoise
  acquisition_scheme:
    name: hardi
    params:
      num_acquisitions: 200
  prior_mask_alpha: 1.0
  prior_mask_beta: 1.0
model:
  embedding_net:
    name: DMRIEmbeddingConfig
    params:
      num_layers: 2
      num_heads: 4
      widening_factor: 4
      attn_size: 16
      dropout_rate: null
      bvals_embed_dim: 6
      signals_embed_dim: 6
      bvec_repeats: 2
      log_transform_signals: true
  inference_net:
    name: DMRIThetaInferenceConfig
    params:
      num_layers: 6
      num_heads: 4
      widening_factor: 4
      attn_size: 16
      context_dim: 64
  model_selection_net:
    name: DMRIModelSelectionAmortizedPriorConfig
    params:
      num_layers: 4
      num_heads: 4
      widening_factor: 4
      attn_size: 16
      dropout_rate: null
      context_dim: 64
      mask_prior_dim: 1
  init_seed: 0
  name: DMRIInferenceModelConfigMaskPriorAmortized
  model_dim: 64
train:
  optimizer:
    optimizer: adamw
    scheduler: cosine_onecycle_schedule
    scheduler_params:
      transition_steps: 20000
      peak_value: 0.001
      pct_start: 0.3
      div_factor: 100.0
      final_div_factor: 0.1
    ema: false
    ema_decay: 0.9
    adaptive_gradient_clipping: true
    gradient_clip_value: 10.0
  dataloader:
    name: StreamDataLoader
    train_params:
      batch_size: 2048
      max_queue_size: 2000
      num_producers: 6
    val_params:
      batch_size: 512
      max_queue_size: 1000
      num_producers: 1
  inner_steps: 50
  checkpoint_freq: 2000
  eval_freq: 2000
  continue_training: false
  max_train_hours: 12
partition: {}

