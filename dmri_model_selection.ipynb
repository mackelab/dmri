    "        self.thetas_stick = []\n",
    "        self.phis_stick = []\n",
    "    \n",
    "        for i in range(num_sticks):\n",
    "            self.thetas_stick.append(nnx.Param(jax.random.normal(rngs.next(), (3))))\n",
