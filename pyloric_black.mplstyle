# Matplotlib Style File for Black Background

# Text and Font
text.usetex          : False
mathtext.default     : regular

font.family          : sans-serif
font.sans-serif      : Arial
font.serif           : Arial
font.cursive         : Arial
mathtext.fontset     : dejavuserif
font.size            : 9
figure.titlesize     : 9
legend.fontsize      : 9
axes.titlesize       : 9
axes.labelsize       : 9
xtick.labelsize      : 9
ytick.labelsize      : 9

# Background Colors
figure.facecolor     : black       # Overall figure background
axes.facecolor       : black       # Axes background
savefig.facecolor    : black       # Background color of saved figures

# Text and Label Colors
text.color           : white       # General text color
axes.labelcolor      : white       # Axes labels
xtick.color          : white       # X-axis tick labels
ytick.color          : white       # Y-axis tick labels
axes.titlecolor      : white       # Title text color

# Image Settings
image.interpolation   : nearest
image.resample        : False
image.composite_image : True

# Axes and Spines
axes.spines.left     : True
axes.spines.bottom   : True
axes.spines.top      : False
axes.spines.right    : False
axes.edgecolor       : white       # Axes edge color

axes.linewidth       : 1.5
xtick.major.width    : 1.5
xtick.minor.width    : 1.5
ytick.major.width    : 1.5
ytick.minor.width    : 1.5

# Lines and Markers
lines.linewidth      : 1.5
lines.markersize     : 3
lines.color          : white       # Default line color

# Grid
grid.color           : gray        # Grid line color
grid.linestyle       : --          # Dashed grid lines
grid.linewidth       : 0.5

# Savefig Settings
savefig.dpi          : 300
savefig.format       : svg
savefig.bbox         : tight
savefig.pad_inches   : 0.1
savefig.facecolor    : black       # Ensures black background when saving

# SVG Settings
svg.image_inline     : True
svg.fonttype         : none

# Legend
legend.frameon       : False
legend.edgecolor     : white       # Color for legend edges
legend.facecolor     : black       # Legend background color
legend.labelcolor    : white       # Legend text color
